<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Tema" parent="android:Theme.Material.Light.DarkActionBar">
        <item name="android:colorPrimary">@color/barra</item>
        <item name="android:colorPrimaryDark">@color/barra_scura</item>
        <item name="android:colorAccent">@color/primario</item>
        <item name="android:windowBackground">@color/sfondo</item>
    </style>

    <!-- Schermata iniziale: niente barra del titolo, barra di stato in tinta con lo sfondo. -->
    <style name="Tema.Home" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/barra</item>
        <item name="android:colorPrimaryDark">@color/sfondo</item>
        <item name="android:colorAccent">@color/primario</item>
        <item name="android:windowBackground">@color/sfondo</item>
        <item name="android:statusBarColor">@color/sfondo</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
