<?xml version="1.0" encoding="utf-8"?>
<!--
    Da Android 12. Salva solo i codici esercente, così tornano su un telefono nuovo;
    restano fuori cookie, cache e archivio della WebView.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="impostazioni.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="impostazioni.xml" />
    </device-transfer>
</data-extraction-rules>
